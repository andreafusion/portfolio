---
import Image from "astro/components/Image.astro";
import pfp from "../assets/pfp.webp";
import { PROFILE } from "../data/profile";
---

<main
  class="mt-24 p-20 font-recursive animate-enter delay-200 min-h-fit w-full overflow-hidden"
>
  <div
    class="px-4 lg:ml-32 lg:px-0 font-recursive h-fit tracking-tight font-semibold flex flex-col md:flex-row align-middle items-center mt-10 gap-4 md:gap-0"
  >
    <h1
      class="text-4xl md:text-5xl dark:text-white transition-colors duration-300"
    >
      {PROFILE.greeting}
    </h1>

    <Image
      src={pfp}
      alt={PROFILE.altText}
      width={400}
      format="png"
      quality={"max"}
      class="size-32 md:size-48 scale-100 md:scale-50 rounded-3xl border-[6px] border-white dark:border-gray-500 shadow-2xl -rotate-5 hover:rotate-0 transition-all duration-300 ease-out transform-gpu will-change-transform md:-ml-6 md:-mr-6 my-4 md:my-0"
    />
    <h1
      class="text-4xl md:text-5xl dark:text-white transition-colors duration-300"
    >
      {PROFILE.shortName}.
    </h1>
  </div>

  <div
    class="px-4 lg:ml-32 lg:px-0 font-recursive tracking-tight flex flex-col md:flex-row mt-6 md:-mt-4 text-center md:text-left"
  >
    <h1
      class="text-3xl md:text-5xl font-semibold leading-tight dark:text-gray-100 transition-colors duration-300"
    >
      {PROFILE.headlinePrefix} 
      <span class="relative inline-block whitespace-nowrap">
        <span class="relative z-10">{PROFILE.highlightWord}</span>

        <svg
          viewBox="0 0 200 20"
          preserveAspectRatio="none"
          class="absolute -bottom-1 md:-bottom-2 left-0 w-[105%] h-3 md:h-5 text-[#4a80d9] opacity-90 -rotate-1 pointer-events-none"
        >
          <path
            class="animate-scribble"
            d="M5 12 C 50 10, 150 10, 195 12 C 140 18, 60 20, 10 18"
            stroke="currentColor"
            stroke-width="3"
            fill="transparent"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      {PROFILE.headlineSuffix}

    </h1>
  </div>

  <div
    class="px-6 lg:ml-32 lg:px-0 mt-12 md:mt-10 font-recursive tracking-tight flex flex-col gap-8 animate-enter delay-200 items-center md:items-start"
  >
    <div class="flex flex-col gap-8 animate-enter delay-200 items-center md:items-start w-full">

  <!-- Current Focus -->
<div class="flex flex-col gap-3 items-center md:items-start w-full">
  <h2
    class="text-lg font-bold text-gray-900/85 dark:text-gray-200 uppercase tracking-widest pl-1 transition-colors duration-300 text-center md:text-left"
  >
    {PROFILE.focusTitle}
  </h2>

  <div class="flex flex-row gap-4 flex-wrap justify-center md:justify-start">
    {PROFILE.focusItems.map((item, index) => {
      const isFirst = index === 0;

      const wrapperHover = isFirst
        ? "hover:border-blue-300 dark:hover:border-blue-500/50 hover:bg-blue-50 dark:hover:bg-blue-900/20"
        : "hover:border-purple-300 dark:hover:border-purple-500/50 hover:bg-purple-50 dark:hover:bg-purple-900/20";

      const iconHover = isFirst
        ? "group-hover:text-blue-600 dark:group-hover:text-blue-400"
        : "group-hover:text-purple-600 dark:group-hover:text-purple-400";

      return (
        <div class="relative group flex flex-col items-center">
          <div
            aria-label={item}
            title={item}
            tabindex="0"
            class={`p-3 ...`}
          >

            {isFirst ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`text-gray-600 dark:text-gray-400 transition-colors ${iconHover}`}
                aria-hidden="true"
                focusable="false"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M10 4v4"></path>
                <path d="M2 8h20"></path>
                <path d="M6 4v4"></path>
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`lucide lucide-pen-tool-icon lucide-pen-tool text-gray-600 dark:text-gray-400 transition-colors ${iconHover}`}
                aria-hidden="true"
                focusable="false"
              >
                <path d="M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z"></path>
                <path d="m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18"></path>
                <path d="m2.3 2.3 7.286 7.286"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
            )}
          </div>

          <!-- Tooltip (desktop only) -->
          <div
            class="hidden [@media(hover:hover)]:block absolute bottom-full left-1/2 -translate-x-1/2 mb-3 px-3 py-1.5 bg-white/80 dark:bg-gray-800/90 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl rounded-lg text-xs font-medium text-gray-800 dark:text-gray-200 whitespace-nowrap opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 scale-95 group-hover:scale-100 transition-all duration-300 ease-out origin-bottom pointer-events-none z-20"
            role="tooltip"
          >
            {item}
          </div>

          <!-- Label (mobile only) -->
          <span class="mt-2 [@media(hover:hover)]:hidden text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">
            {item}
          </span>
        </div>
      );
    })}
  </div>
</div>

<!-- Downtime & Hobbies -->
<div class="flex flex-col gap-3 items-center md:items-start w-full">
  <h2
    class="text-lg font-bold text-gray-900/85 dark:text-gray-200 uppercase tracking-widest pl-1 transition-colors duration-300 text-center md:text-left"
  >
    {PROFILE.hobbiesTitle}
  </h2>

  <div class="flex flex-row gap-4 flex-wrap justify-center md:justify-start">
    {PROFILE.hobbies.map((hobby) => {
      const wrapperHover =
        hobby.theme === "emerald"
          ? "hover:border-emerald-300 dark:hover:border-emerald-500/50 hover:bg-emerald-50 dark:hover:bg-emerald-900/20"
          : hobby.theme === "purple"
          ? "hover:border-purple-300 dark:hover:border-purple-500/50 hover:bg-purple-50 dark:hover:bg-purple-900/20"
          : "hover:border-rose-300 dark:hover:border-rose-500/50 hover:bg-rose-50 dark:hover:bg-rose-900/20";

      const iconHover =
        hobby.theme === "emerald"
          ? "group-hover:text-emerald-600 dark:group-hover:text-emerald-400"
          : hobby.theme === "purple"
          ? "group-hover:text-purple-600 dark:group-hover:text-purple-400"
          : "group-hover:text-rose-600 dark:group-hover:text-rose-400";

      return (
        <div class="relative group flex flex-col items-center">
          <div
            aria-label={item}
            title={item}
            tabindex="0"
            class={`p-3 ...`}
          >

            {hobby.icon === "leaf" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`text-gray-600 dark:text-gray-400 transition-colors ${iconHover}`}
                aria-hidden="true"
                focusable="false"
              >
                <path d="M11 20A7 7 0 0 1 4 13C4 7 12 4 12 4s8 3 8 9a7 7 0 0 1-7 7" />
                <path d="M12 4v16" />
              </svg>
            )}

            {hobby.icon === "pencil" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`text-gray-600 dark:text-gray-400 transition-colors ${iconHover}`}
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5z" />
              </svg>
            )}

            {hobby.icon === "music" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={`text-gray-600 dark:text-gray-400 transition-colors ${iconHover}`}
                aria-hidden="true"
                focusable="false"
              >
                <path d="M9 18V5l12-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="18" cy="16" r="3" />
              </svg>
            )}
          </div>

          <!-- Tooltip (desktop only) -->
          <div
            class="hidden [@media(hover:hover)]:block absolute bottom-full left-1/2 -translate-x-1/2 mb-3 px-3 py-1.5 bg-white/80 dark:bg-gray-800/90 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl rounded-lg text-xs font-medium text-gray-800 dark:text-gray-200 whitespace-nowrap opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 scale-95 group-hover:scale-100 transition-all duration-300 ease-out origin-bottom pointer-events-none z-20"
            role="tooltip"
          >
            {hobby.name}
          </div>

          <!-- Label (mobile only) -->
           font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 text-center">
            {hobby.name}
          </span>
        </div>
      );
    })}
  </div>
</div>


    <div
      class="mt-4 relative w-full max-w-137 group cursor-pointer self-center md:self-start"
    >
      <div
        class="absolute -inset-2 bg-linear-to-r from-cyan-400 via-purple-400 to-pink-400 rounded-[20px] blur-2xl opacity-25 group-hover:opacity-50 animate-pulse-siri transition duration-500"
      >
      </div>

      <a
        href="#contact"
        class="relative flex items-center justify-between
               bg-white/60 dark:bg-gray-900/80
               backdrop-blur-xl
               border border-white/80 dark:border-white/10
               shadow-sm rounded-xl px-4 py-3
               hover:scale-[1.01] transition-all duration-300"
      >
        <div class="flex flex-col ml-2">
          <span
            class="text-xl font-light text-gray-800 dark:text-gray-100 tracking-tight transition-colors"
            >{PROFILE.ctaTitle}</span
          >
          <span
            class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-0.5 group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors"
            >{PROFILE.ctaSubtitle} <span
              class="text-blue-500/80 dark:text-blue-400/80 hidden sm:inline"
              >press enter</span
            ><span class="text-blue-500/80 dark:text-blue-400/80 sm:hidden"
              >tap here</span
            >
          </span>
        </div>

        <div
          class="flex items-center justify-center size-9
                 bg-linear-to-b from-gray-50 to-gray-100
                 dark:from-gray-800 dark:to-gray-900
                 border border-gray-200 border-b-2
                 dark:border-gray-700 dark:border-b-gray-600
                 rounded-lg
                 group-hover:border-blue-300 dark:group-hover:border-blue-500/50
                 transition-colors shadow-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-gray-400 dark:text-gray-500 group-hover:text-blue-500 dark:group-hover:text-blue-400"
          >
            <path d="M9 10L4 15L9 20"></path>
            <path d="M20 4V11C20 13.2091 18.2091 15 16 15H4"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</main>

<script>
  const contactSection = document.getElementById("contact");
  document.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      // Validación extra para evitar scroll si no hay sección
      if (contactSection) {
        event.preventDefault();
        contactSection.scrollIntoView({
          behavior: "smooth",
        });
      }
    }
  });
</script>

<style>
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .animate-scribble {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: draw 0.8s ease-out 0.8s forwards;
  }

  @keyframes enter-slide-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-enter {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .animate-enter {
      animation: enter-slide-up 3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  .delay-100 {
    animation-delay: 100ms;
  }
  .delay-200 {
    animation-delay: 200ms;
  }
  .delay-300 {
    animation-delay: 300ms;
  }
  .delay-500 {
    animation-delay: 500ms;
  }

  @keyframes pulse-siri {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.98);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.01);
    }
  }

  .animate-pulse-siri {
    animation: pulse-siri 4s ease-in-out infinite;
  }
</style>
