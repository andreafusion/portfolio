---
import { PROJECTS } from "../data/projects";
---

<div
  id="projects"
  class="font-inter flex flex-col w-full max-w-7xl mx-auto mb-20 p-4 sm:p-6 md:p-10
         bg-gray-200 dark:bg-gray-900/60
         backdrop-blur-xl
         border border-white/40 dark:border-white/10
         shadow-xl rounded-3xl
         animate-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out"
>
  <div class="flex flex-row items-center justify-center lg:justify-start lg:ml-8 mb-8">
    <div class="p-2 bg-gray-950 text-gray-100 dark:bg-white dark:text-black rounded-xl mr-3 transition-colors">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-briefcase"
      >
        <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        <rect width="20" height="14" x="2" y="6" rx="2"></rect>
      </svg>
    </div>

    <h1 class="text-2xl sm:text-3xl font-semibold text-black dark:text-white text-center sm:text-left transition-colors">
      Meet my Work
    </h1>
  </div>

  <div class="flex flex-col gap-8 justify-center items-center w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 w-full max-w-5xl px-2">

      {PROJECTS.map((project, index) => {
        const isExternal = project.url && !project.url.startsWith("#");

        return (
          <div
            class="group flex flex-col h-auto min-h-96 sm:min-h-120 w-full max-w-md mx-auto p-5
                   bg-white/50 dark:bg-gray-800/40 backdrop-blur-2xl
                   border border-white/40 dark:border-white/5 shadow-sm rounded-3xl
                   hover:shadow-lg hover:bg-white/60 dark:hover:bg-gray-800 hover:-translate-y-1
                   transition-all duration-500 animate-on-scroll opacity-0 translate-y-8"
            style={`transition-delay: ${100 + index * 100}ms`}
          >
            <div class="relative w-full h-48 sm:h-64 rounded-2xl overflow-hidden shadow-sm border border-black/5 dark:border-white/5 mb-6">
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500 z-10"></div>

              <img
                src={project.image}
                alt={project.alt}
                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
              />
            </div>

            <div class="flex flex-col px-1 grow">
              <div class="flex items-center flex-wrap gap-2 text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 font-recursive">
                <span>{project.year}</span>
                <span class="text-gray-300 dark:text-gray-600">•</span>
                <span>{project.metaLeft}</span>
                <span class="text-gray-300 dark:text-gray-600">•</span>
                <span class={project.metaRightClass}>{project.metaRight}</span>
              </div>

              <h3 class={`text-2xl font-recursive font-semibold text-gray-800 dark:text-gray-100 tracking-tight leading-tight mb-2 transition-colors ${project.titleHoverClass}`}>
                {project.title}
              </h3>

              <p class="text-sm text-gray-500 dark:text-gray-400 font-medium leading-relaxed line-clamp-2">
                {project.description}
              </p>
            </div>

            <div class="mt-auto self-end pt-4">
              <a
                href={project.url}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class={`size-10 rounded-full bg-gray-100/50 dark:bg-gray-700/50 text-gray-400 dark:text-gray-300 group-hover:text-white flex items-center justify-center transition-all duration-300 ${project.buttonHoverClass}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        );
      })}

    </div>
  </div>
</div>

<script>
  const observerOptions = { root: null, rootMargin: "0px", threshold: 0.1 };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove("opacity-0", "translate-y-8");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll(".animate-on-scroll").forEach((el) => {
    observer.observe(el);
  });
</script>
